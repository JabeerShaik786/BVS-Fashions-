# ==============================================================================
# BVS FASHIONS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Server Port
PORT=3001

# Supabase Project Credentials
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-secret

# Frontend Configuration (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:3001/api

# WhatsApp Business Ordering Phone Number (Include country code without '+' or special characters)
# Example for BVS Fashions: 918639778188 (https://wa.me/918639778188)
VITE_WHATSAPP_PHONE_NUMBER=918639778188
